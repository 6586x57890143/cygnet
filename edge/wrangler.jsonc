{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cygnet-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "cygnet.lol", "custom_domain": true }],
  "assets": { "directory": "./public" },
  // A sign up makes several D1 round trips: the Worker runs beside the
  // database, while the art is still served from the edge nearest the
  // person.
  "placement": { "mode": "smart" },
  "d1_databases": [
    // database_id comes from `wrangler d1 create cygnet-edge` (docs/edge.md).
    { "binding": "DB", "database_name": "cygnet-edge", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // The links that prove an address. Needs the paid plan; signup.ts's
  // budget keeps it inside the emails the plan includes.
  "send_email": [{ "name": "EMAIL" }],
  // Forgets the hashes that have done their job (src/signup.ts).
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": {
    // cygnet's application ID and the Turnstile widget's site key, both
    // public. The secrets are DISCORD_CLIENT_SECRET, TURNSTILE_SECRET,
    // HMAC_KEY and ADMIN_TOKEN, set with `wrangler secret put`.
    "DISCORD_CLIENT_ID": "",
    "TURNSTILE_SITEKEY": "",
    // The silcord server's picture: https://cdn.discordapp.com/icons/<guild>/<hash>.webp
    "ICON": ""
  },
  // Off: a request's URL can hold an invite code, and logs keep URLs.
  "observability": { "enabled": false }
}
