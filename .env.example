DISCORD_BOT_TOKEN=
# The break glass: always passes the Admin tier and BreakGlass, in every
# guild, whatever else is true. One Discord ID, or several comma separated;
# the first is the one a surface names (the support page, unless
# CYGNET_SUPPORT_OWNER says otherwise).
CYGNET_BOOTSTRAP_ADMIN_USER_ID=
# Optional. Unset runs without a database; /status says so.
CYGNET_DATABASE_URL=
# Optional, loopback only, e.g. 127.0.0.1:6060. Used to capture default.pgo.
# Debugging only, never in prod: it also runs the flight recorder, which
# keeps the runtime tracer on and every goroutine paying for it.
CYGNET_PPROF=
CYGNET_LOG_LEVEL=info

# docker-compose.prod.yml's Postgres. CYGNET_DATABASE_URL must match:
# postgres://cygnet:<password>@postgres:5432/cygnet?sslmode=disable
POSTGRES_USER=cygnet
POSTGRES_PASSWORD=changeme

# Optional. The birds that may link to cygnet's hub, name=token, commas
# between. One token per bot (openssl rand -hex 32), given to that bot as its
# CYGNET_TOKEN with CYGNET_URL=ws://cygnet:7700/v1/link. Unset, no hub runs.
# edge=<token> is cygnet.lol's Worker, which redeems /invite's links with
# POST /v1/call through the tunnel (docs/edge.md); it is the Worker's
# CYGNET_HUB_TOKEN.
CYGNET_BOTS=
CYGNET_HUB_ADDR=:7700
# Each bird's release public key: name=key,name=key (go run ./link/cmd/attest
# -new). A bird listed here links only with a build its CI signed, and once
# any is listed, only signed birds get permissions granted.
CYGNET_BIRD_KEYS=
# The read-only Docker proxy (the docker service in docker-compose.prod.yml)
# that lets cygnet check a signed bird's container runs the signed image.
# The prod compose file sets it; unset, birds stay signed, never attested.
# CYGNET_DOCKER=http://docker:2375

# Keys a launch's ledger and names people in it (openssl rand -base64 32).
# Set it once: changing it makes the ledger unverifiable. Unset, or under 32
# characters, cygnet runs no launches.
CYGNET_LEDGER_KEY=

# Opens the sign ins people seal to cygnet to be added when their launch
# opens (go run ./tools/sealkey; its public half is the Worker's
# CYGNET_SEAL_PUBLIC). Unset, nobody is offered that.
CYGNET_SEAL_KEY=
# The app's OAuth secret, the Worker's DISCORD_CLIENT_SECRET: refreshes a
# sealed sign in at its wave, so cygnet can add its person.
CYGNET_CLIENT_SECRET=

# The Worker at cygnet.lol, for /launch. CYGNET_EDGE_TOKEN is the
# Worker's ADMIN_TOKEN. Unset, /launch says it isn't connected.
CYGNET_EDGE_URL=
CYGNET_EDGE_TOKEN=

# Backing the birds (docs/support.md): the wallets supporters pay into, each
# optional, checked at boot. One 0x address takes Base and Polygon. Unset,
# nothing is offered and support.cygnet.lol says backing opens soon.
CYGNET_SUPPORT_EVM=
CYGNET_SUPPORT_SOLANA=
CYGNET_SUPPORT_TRON=
# Whose wallets they are, named on the page. Unset, the bootstrap admin.
CYGNET_SUPPORT_OWNER=
# Keyed nodes in place of the public ones, which rate limit, and a TronGrid
# key. Each optional.
CYGNET_RPC_BASE=
CYGNET_RPC_ETHEREUM=
CYGNET_RPC_POLYGON=
CYGNET_RPC_SOLANA=
CYGNET_TRONGRID_KEY=
# Native ETH discovery, including contract sends: Alchemy Transfers API
# URLs (containing API keys), separate from standard receipt-verification
# RPC above. Each enables ETH on that network; unset, it isn't offered.
CYGNET_NATIVE_BASE=
CYGNET_NATIVE_ETHEREUM=
# Private view-only wallet RPC. Seed and view key stay in its wallet file,
# never in cygnet, the Worker or Merlin. Empty disables Monero completely.
CYGNET_SUPPORT_MONERO=
CYGNET_XMR_RPC=
CYGNET_XMR_RPC_USER=
CYGNET_XMR_RPC_PASSWORD_FILE=
CYGNET_XMR_RPC_CA_FILE=
# Mainnet by default; use Stagenet in a separate test deployment.
CYGNET_XMR_NETWORK=
