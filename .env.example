DISCORD_BOT_TOKEN=
# Always passes the Admin tier, in every guild, whatever else is true.
CYGNET_BOOTSTRAP_ADMIN_USER_ID=
# Optional. Unset runs without a database; /status says so.
CYGNET_DATABASE_URL=
# Optional, loopback only, e.g. 127.0.0.1:6060. Used to capture default.pgo.
# Debugging only, never in prod: it also runs the flight recorder, which
# keeps the runtime tracer on and every goroutine paying for it.
CYGNET_PPROF=
CYGNET_LOG_LEVEL=info

# docker-compose.prod.yml's Postgres. CYGNET_DATABASE_URL must match:
# postgres://cygnet:<password>@postgres:5432/cygnet?sslmode=disable
POSTGRES_USER=cygnet
POSTGRES_PASSWORD=changeme

# Optional. The birds that may link to cygnet's hub, name=token, commas
# between. One token per bot (openssl rand -hex 32), given to that bot as its
# CYGNET_TOKEN with CYGNET_URL=ws://cygnet:7700/v1/link. Unset, no hub runs.
CYGNET_BOTS=
CYGNET_HUB_ADDR=:7700
